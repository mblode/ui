NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog ingestion host: our reverse proxy in front of PostHog, so tracker
# blockers do not drop analytics. Unset falls back to posthog-js's own
# default (https://us.i.posthog.com).
NEXT_PUBLIC_POSTHOG_HOST=https://r.blode.co

# Google Fonts Developer API key, server-only, used by /api/google-fonts to
# proxy the catalogue for the Font Picker demo. Create one in the Google Cloud
# Console with the Web Fonts Developer API enabled. Optional: without it that
# route answers 503 and the picker shows its "no key" state.
GOOGLE_FONTS_API_KEY=

# Blode UI Pro is test-only and fails closed unless every required value is
# present. These must come from one published Lemon Squeezy test product with
# licence keys enabled. Live-mode credentials are intentionally unsupported.
BLODE_UI_PRO_TEST_MODE=false
BLODE_UI_PRO_LEMON_SQUEEZY_STORE_ID=
BLODE_UI_PRO_LEMON_SQUEEZY_PRODUCT_ID=
# Optional comma-separated allowlist. Leave empty to accept every variant of
# the configured product.
BLODE_UI_PRO_LEMON_SQUEEZY_VARIANT_IDS=
BLODE_UI_PRO_TEST_CHECKOUT_URL=
BLODE_UI_PRO_TEST_PRICE_LABEL=
