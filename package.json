{
  "name": "blode-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run next dev --turbopack",
    "build": "npm run build:docs && npm run check:registry-deps && npm run build:registry && node scripts/build-well-known-skills.mjs && node scripts/build-design-md.mjs && next build --turbopack",
    "build:docs": "content-collections build",
    "build:registry": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/build-registry.mts",
    "registry:build": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/build-registry.mts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check:types": "tsc --noEmit",
    "preview": "next build && next start -p 3333",
    "typecheck": "npm run build:docs && tsc --noEmit",
    "prepare": "lefthook install || true",
    "check": "npm run check:registry-deps && ultracite check",
    "test": "vitest run",
    "check:registry-deps": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/check-registry-deps.mts",
    "fix": "ultracite fix",
    "knip": "knip",
    "knip:production": "knip --production --strict",
    "test:instant": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.2.4",
    "@types/lodash.template": "^4.5.3",
    "blode-icons-react": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "copy-to-clipboard": "^4.0.2",
    "critters": "^0.0.25",
    "date-fns": "4.4.0",
    "downshift": "9.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "jotai": "^3.0.0",
    "lodash": "^4.18.1",
    "merge-refs": "^2.0.0",
    "motion": "^13.4.1",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "postcss": "8.5.28",
    "posthog-js": "^1.434.9",
    "react": "19.3.0",
    "react-currency-input-field": "^4.0.6",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-phone-number-input": "^3.4.18",
    "react-resizable-panels": "^4.13.2",
    "react-textarea-autosize": "^8.5.9",
    "react-tweet": "^3.3.1",
    "recharts": "^3.10.1",
    "remark": "^15.0.1",
    "shadcn": "4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "^0.15.3",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@next/playwright": "16.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unist": "^3.0.3",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "mdast-util-toc": "^7.1.0",
    "oxfmt": "^0.70.0",
    "oxlint": "1.78.0",
    "portless": "^0.15.6",
    "rehype": "^13.0.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "6.0.0",
    "remark-code-import": "^1.2.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "7.9.3",
    "unist-builder": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "date-fns": "4.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
